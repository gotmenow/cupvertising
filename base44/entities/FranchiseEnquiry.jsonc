{
  "name": "FranchiseEnquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Applicant name"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "City or territory of interest"
    },
    "investment_capital": {
      "type": "string",
      "enum": [
        "Under \u00a310k",
        "\u00a310k - \u00a325k",
        "\u00a325k - \u00a350k",
        "\u00a350k+"
      ],
      "description": "Available investment capital"
    },
    "experience": {
      "type": "string",
      "description": "Brief summary of relevant experience"
    },
    "linkedin_profile": {
      "type": "string",
      "description": "LinkedIn profile URL"
    }
  },
  "required": [
    "name",
    "email",
    "city",
    "investment_capital"
  ]
}